# --- Secrets: never commit these ---
# Firebase Admin SDK key (full access to your Firestore)
config/service_account.json
# Encrypted credentials store (unreadable elsewhere, but still not for version control)
config/*.dat
config/*.dat.tmp
*-firebase-adminsdk-*.json
service_account*.json

# --- Local data ---
# Inventory database, its journals, and the automatic pre-migration backup
database/
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
installer/Output/
installer/app.ico

# --- Firebase CLI ---
.firebase/
firebase-debug.log
firebase-debug.*.log
node_modules/

# --- Editor / OS / tool clutter ---
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
Screenshot*.png
