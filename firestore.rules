rules_version = '2';

// The mobile app (mobile_scanner_app.html) talks to Firestore directly and
// unauthenticated — there's no Firebase Auth sign-in step. These rules are
// the only thing standing between "anyone with the project's public web
// config" and write access, so they intentionally allow create-only access
// to a narrow, validated shape and nothing else.
//
// The desktop app (pc_backend_automation_service.py) instead uses the
// Admin SDK via config/service_account.json, which bypasses these rules
// entirely — that's expected and is how it reads/deletes synced scans.
//
// This isn't a strong security boundary on its own (the pairing token is
// just a shared secret embedded in the pairing QR, not real per-device
// auth) — it just guards against a stray or malformed write, the same
// trust level the previous Apps Script `token` check provided.
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    match /scans/{scanId} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['timestamp', 'barcode', 'action', 'expiry', 'quantity', 'token']
                      )
                    && request.resource.data.timestamp is string
                    && request.resource.data.barcode is string
                    && request.resource.data.barcode.size() > 0
                    && request.resource.data.action in ['ADD', 'REMOVE']
                    && request.resource.data.expiry is string
                    && request.resource.data.quantity is number
                    && request.resource.data.quantity > 0
                    && request.resource.data.token is string
                    && request.resource.data.token.size() > 0;

      // Only the desktop app's Admin SDK connection may read or delete —
      // that's how synced scans get pulled into the local database and
      // cleared, and unauthenticated clients have no reason to read them.
      allow read, update, delete: if false;
    }

    match /presence/{token} {
      // The mobile heartbeat writes {lastSeen: serverTimestamp()} to its
      // own token's doc so the desktop app can show a connected/offline
      // status.
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen']);
      allow read, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
